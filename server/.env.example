# ==== 眼互后端部署环境变量模板（WS2）====
# 1) 复制为 .env（已被 gitignore，勿提交到仓库）
# 2) 全部必填；生成强随机值：openssl rand -base64 48
# 3) 后端 ProdCredentialValidator 会在启动时强制校验：缺失 / 历史默认值 / root 账号 / JWT secret < 32 字节 一律拒停

# MySQL 应用账号（独立低权限账号，仅授权 eye_monitor 库；勿用 root）
DB_USER=eye
# MySQL 应用密码（强随机）
DB_PASS=REPLACE_WITH_openssl_rand_base64_48
# MySQL root 密码（仅容器内维护用，同样强随机且不对外）
DB_ROOT_PASS=REPLACE_WITH_ROOT_openssl_rand_base64_48
# JWT 签名密钥（HS256，必须 ≥ 32 字节；登录 token 与 WS 握手鉴权均依赖它）
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48
# 部署到阿里云 ECS 后：改为 ECS 的 tailnet 内网 IP（ECS 上执行 tailscale ip -4 查看）
# 默认 127.0.0.1 是安全回退（仅本机可访）；公网端口扫描应保持 0 开放（AC1）
TAILNET_IP=127.0.0.1