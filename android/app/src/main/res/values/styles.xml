<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         眼互组件样式体系 v1（核心子集）
         原则：
         1. 布局只引用这些样式 + ?attr/ 语义令牌 + @dimen/ 尺寸令牌
         2. 一律 textAllCaps=false（Material 默认会大写拉丁字符）
         3. themes.xml 已把 materialButtonStyle / radioButtonStyle /
            editTextStyle 指到本文件 -> 裸控件也自动统一（防呆）
         ============================================================ -->

    <!-- ========== 按钮体系 ========== -->

    <!-- 基础形态：所有按钮的地基（也是 materialButtonStyle 全局默认） -->
    <style name="Widget.EyeMonitor.Button.Default" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_15</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:paddingTop">@dimen/space_8</item>
        <item name="android:paddingBottom">@dimen/space_8</item>
        <!-- 2026-10 修复：Material 内嵌 insets + 原 12dp padding 挤压矮按钮文字区（48dp 高被裁） -->
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!-- M4 爱心点缀：按压弹性（Header 系列另行覆盖为 @null） -->
        <item name="android:stateListAnimator">@animator/btn_press_scale</item>
    </style>

    <!-- 主操作：暖色填充（AA：白字 4.67:1 → 深玫瑰底） -->
    <style name="Widget.EyeMonitor.Button.Primary" parent="Widget.EyeMonitor.Button.Default">
        <item name="backgroundTint">@color/primary_fill</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="iconTint">@color/text_on_primary</item>
    </style>

    <!-- 可选 Chip（奖励/拒绝理由单选）：未选中浅粉底深字，选中珊瑚底白字，无勾号无关闭x -->
    <style name="Widget.EyeMonitor.Chip.Selectable" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipCornerRadius">@dimen/radius_lg</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="android:textSize">@dimen/text_13</item>
        <item name="chipMinHeight">34dp</item>
    </style>

    <!-- 次级操作：描边样式 -->
    <style name="Widget.EyeMonitor.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/primary_text</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="iconTint">@color/primary_text</item>
        <item name="android:textSize">@dimen/text_14</item>
        <item name="android:paddingTop">@dimen/space_10</item>
        <item name="android:paddingBottom">@dimen/space_10</item>
    </style>

    <!-- 头栏按钮：半透明白底，用于渐变头栏上 -->
    <!-- 重要：必须 compact（minHeight=0 + inset=0 + paddingTop/Bottom=4dp）否则撑满头栏呈矩形块； -->
    <!-- 必须去 elevation/stateListAnimator，否则透明底+阴影=黑框 -->
    <style name="Widget.EyeMonitor.Button.Header" parent="Widget.EyeMonitor.Button.Default">
        <item name="backgroundTint">@color/header_btn_bg</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textSize">@dimen/text_13</item>
        <item name="android:paddingLeft">@dimen/space_12</item>
        <item name="android:paddingRight">@dimen/space_12</item>
        <item name="android:paddingTop">@dimen/space_4</item>
        <item name="android:paddingBottom">@dimen/space_4</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 头栏文字按钮：纯文字（透明底），用于渐变头栏上的轻量操作 -->
    <!-- 注意：不要在渐变头栏上并排多个 Header 胶囊，会呈矩形块观感 -->
    <style name="Widget.EyeMonitor.Button.HeaderText" parent="Widget.EyeMonitor.Button.Header">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:paddingLeft">@dimen/space_8</item>
        <item name="android:paddingRight">@dimen/space_8</item>
    </style>

    <!-- 头栏动作按钮：Header 系列的 44dp 热区版（消灭 5 布局的 6 属性手工样板） -->
    <style name="Widget.EyeMonitor.Button.HeaderAction" parent="Widget.EyeMonitor.Button.Header">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
    </style>

    <!-- 弹窗按钮：44dp 紧凑、14sp（任务弹窗等） -->
    <style name="Widget.EyeMonitor.Button.Dialog" parent="Widget.EyeMonitor.Button.Primary">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">@dimen/text_14</item>
    </style>

    <!-- 弹窗次级按钮：描边紧凑版 -->
    <style name="Widget.EyeMonitor.Button.DialogOutlined" parent="Widget.EyeMonitor.Button.Outlined">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">@dimen/text_14</item>
    </style>

    <!-- 危险操作：状态红填充（删除/解绑/SOS 等） -->
    <style name="Widget.EyeMonitor.Button.Danger" parent="Widget.EyeMonitor.Button.Default">
        <item name="backgroundTint">@color/status_error_fill</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>

    <!-- SOS 专用：保留圆形 shape 背景（android:background 生效），只收敛文字/内衬行为 -->
    <style name="Widget.EyeMonitor.Button.Sos" parent="Widget.EyeMonitor.Button.Default">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_16</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ========== 单选/复选 ========== -->

    <!-- 单选：tint 跟随主题主色 -->
    <style name="Widget.EyeMonitor.RadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:buttonTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textSize">@dimen/text_14</item>
    </style>

    <!-- 复选：tint 跟随主题主色 -->
    <style name="Widget.EyeMonitor.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="android:buttonTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textSize">@dimen/text_14</item>
    </style>

    <!-- 开关：选中主色/未选描边 -->
    <style name="Widget.EyeMonitor.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textSize">@dimen/text_14</item>
    </style>

    <!-- 标签/筛选 chip：主色描边 + 主色文字 -->
    <style name="Widget.EyeMonitor.Chip" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="chipStrokeColor">@color/primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="android:textColor">@color/primary</item>
        <item name="chipCornerRadius">@dimen/radius_md</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">@dimen/space_32</item>
    </style>

    <!-- ========== 卡片 ========== -->

    <!-- 通用圆角卡片：列表项/内容块骨架 -->
    <style name="Widget.EyeMonitor.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <!-- ========== 输入框 ========== -->

    <style name="Widget.EyeMonitor.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textColorHint">?attr/textSecondary</item>
        <item name="android:paddingLeft">@dimen/space_16</item>
        <item name="android:paddingRight">@dimen/space_16</item>
        <item name="android:paddingTop">@dimen/space_10</item>
        <item name="android:paddingBottom">@dimen/space_10</item>
    </style>

    <!-- ========== 排版（TextAppearance 族） ========== -->

    <!-- 头栏标题（渐变头栏上，白字） -->
    <style name="TextAppearance.EyeMonitor.HeaderTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_20</item>
    </style>

    <!-- 页面级标题（20sp 粗） -->
    <style name="TextAppearance.EyeMonitor.Display" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_20</item>
    </style>

    <!-- 区块标题（16sp 中粗） -->
    <style name="TextAppearance.EyeMonitor.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_16</item>
    </style>

    <!-- 正文（14sp） -->
    <style name="TextAppearance.EyeMonitor.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textSize">@dimen/text_14</item>
    </style>

    <!-- 辅助说明（12sp 弱化） -->
    <style name="TextAppearance.EyeMonitor.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">?attr/textSecondary</item>
        <item name="android:textSize">@dimen/text_12</item>
    </style>
</resources>