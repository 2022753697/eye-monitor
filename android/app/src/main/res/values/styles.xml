<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         眼互组件样式体系 v1（核心子集）
         原则：
         1. 布局只引用这些样式 + ?attr/ 语义令牌 + @dimen/ 尺寸令牌
         2. 一律 textAllCaps=false（Material 默认会大写拉丁字符）
         3. themes.xml 已把 materialButtonStyle / radioButtonStyle /
            editTextStyle 指到本文件 -> 裸控件也自动统一（防呆）
         ============================================================ -->

    <!-- ========== 按钮体系 ========== -->

    <!-- 基础形态：所有按钮的地基（也是 materialButtonStyle 全局默认） -->
    <style name="Widget.EyeMonitor.Button.Default" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_15</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:paddingTop">@dimen/space_12</item>
        <item name="android:paddingBottom">@dimen/space_12</item>
    </style>

    <!-- 主操作：暖色填充 -->
    <style name="Widget.EyeMonitor.Button.Primary" parent="Widget.EyeMonitor.Button.Default">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="iconTint">@color/text_on_primary</item>
    </style>

    <!-- 次级操作：描边样式 -->
    <style name="Widget.EyeMonitor.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
        <item name="android:textSize">@dimen/text_14</item>
        <item name="android:paddingTop">@dimen/space_10</item>
        <item name="android:paddingBottom">@dimen/space_10</item>
    </style>

    <!-- 头栏按钮：半透明白底，用于渐变头栏上 -->
    <style name="Widget.EyeMonitor.Button.Header" parent="Widget.EyeMonitor.Button.Default">
        <item name="backgroundTint">@color/white_translucent</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textSize">@dimen/text_13</item>
        <item name="android:paddingLeft">@dimen/space_14</item>
        <item name="android:paddingRight">@dimen/space_14</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 危险操作：状态红填充（删除/解绑/SOS 等） -->
    <style name="Widget.EyeMonitor.Button.Danger" parent="Widget.EyeMonitor.Button.Default">
        <item name="backgroundTint">?attr/statusError</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>

    <!-- SOS 专用：保留圆形 shape 背景（android:background 生效），只收敛文字/内衬行为 -->
    <style name="Widget.EyeMonitor.Button.Sos" parent="Widget.EyeMonitor.Button.Default">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_16</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ========== 单选/复选 ========== -->

    <!-- 单选：tint 跟随主题主色 -->
    <style name="Widget.EyeMonitor.RadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:buttonTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textSize">@dimen/text_14</item>
    </style>

    <!-- ========== 卡片 ========== -->

    <!-- 通用圆角卡片：列表项/内容块骨架 -->
    <style name="Widget.EyeMonitor.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <!-- ========== 输入框 ========== -->

    <style name="Widget.EyeMonitor.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textColorHint">?attr/textSecondary</item>
        <item name="android:paddingLeft">@dimen/space_16</item>
        <item name="android:paddingRight">@dimen/space_16</item>
        <item name="android:paddingTop">@dimen/space_10</item>
        <item name="android:paddingBottom">@dimen/space_10</item>
    </style>

    <!-- ========== 排版（TextAppearance 族） ========== -->

    <!-- 头栏标题（渐变头栏上，白字） -->
    <style name="TextAppearance.EyeMonitor.HeaderTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_20</item>
    </style>

    <!-- 页面级标题（20sp 粗） -->
    <style name="TextAppearance.EyeMonitor.Display" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_20</item>
    </style>

    <!-- 区块标题（16sp 中粗） -->
    <style name="TextAppearance.EyeMonitor.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_16</item>
    </style>

    <!-- 正文（14sp） -->
    <style name="TextAppearance.EyeMonitor.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textSize">@dimen/text_14</item>
    </style>

    <!-- 辅助说明（12sp 弱化） -->
    <style name="TextAppearance.EyeMonitor.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">?attr/textSecondary</item>
        <item name="android:textSize">@dimen/text_12</item>
    </style>
</resources>