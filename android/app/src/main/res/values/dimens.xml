<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         尺寸令牌：间距（8dp 步进）/ 圆角 / 字号
         布局与样式引用 @dimen/xxx，新页面统一按此节奏排版。
         ============================================================ -->

    <!-- 间距 -->
    <dimen name="space_2">2dp</dimen>
    <dimen name="space_4">4dp</dimen>
    <dimen name="space_8">8dp</dimen>
    <dimen name="space_10">10dp</dimen>
    <dimen name="space_12">12dp</dimen>
    <dimen name="space_14">14dp</dimen>
    <dimen name="space_16">16dp</dimen>
    <dimen name="space_24">24dp</dimen>
    <dimen name="space_32">32dp</dimen>

    <!-- 圆角 -->
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_lg">16dp</dimen>
    <dimen name="radius_xl">24dp</dimen>

    <!-- 字号（4 级：12/14/16/20 + 补充 13/15） -->
    <dimen name="text_12">12sp</dimen>
    <dimen name="text_13">13sp</dimen>
    <dimen name="text_14">14sp</dimen>
    <dimen name="text_15">15sp</dimen>
    <dimen name="text_16">16sp</dimen>
    <dimen name="text_20">20sp</dimen>
</resources>
