<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EyeMonitor" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 主色 -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        <item name="colorAccent">@color/accent</item>

        <!-- 表面与背景 -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- 控件色 -->
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlHighlight">@color/white_translucent</item>

        <!-- 系统栏 -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>

        <!-- 默认文本色 -->
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
