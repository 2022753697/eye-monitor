<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗列表行按压反馈：主色淡色高亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#14FF6B6B" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>