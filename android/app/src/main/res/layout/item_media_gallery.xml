<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:padding="2dp">

    <ImageView
        android:id="@+id/iv_gallery_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_media_placeholder" />

    <!-- 批量选中遮罩 + 勾选角标 -->
    <View
        android:id="@+id/v_batch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59FF6B6B"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/fl_batch_check"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/bg_icon_circle"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_batch_check" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/ll_gallery_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_media_placeholder">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_image"
            android:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/tv_gallery_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/media_download_hint"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fl_gallery_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:padding="4dp"
        android:visibility="gone">

        <View
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_play_badge" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_play"
            android:padding="6dp"
            android:contentDescription="@string/video" />
    </FrameLayout>
</FrameLayout>