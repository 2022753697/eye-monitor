<?xml version="1.0" encoding="utf-8"?>
<!-- 消息长按气泡菜单（QQ/微信式）：白圆角卡片 + 竖分隔线，位于消息上方 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_chat_menu_card"
    android:padding="4dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/menu_action_quote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_action_quote"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/menu_action_recall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_action_recall"
        android:textColor="@color/status_error"
        android:textSize="13sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />
</LinearLayout>