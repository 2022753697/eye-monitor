<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:elevation="1dp"
    android:padding="@dimen/space_14"
    android:layout_marginBottom="@dimen/space_12">

    <!-- 第一行：名称+日期（左） / 编辑 / 删除（右） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_anni_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_16"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/space_4">

                <TextView
                    android:id="@+id/tv_anni_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_13" />

                <TextView
                    android:id="@+id/tv_anni_repeat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/anniversary_repeat_badge"
                    android:textColor="@color/accent_text"
                    android:textSize="@dimen/text_11"
                    android:paddingStart="@dimen/space_8"
                    android:paddingEnd="@dimen/space_8"
                    android:paddingTop="@dimen/space_2"
                    android:paddingBottom="@dimen/space_2"
                    android:background="@drawable/bg_card_alt"
                    android:layout_marginStart="@dimen/space_8"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_anni_edit"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:src="@drawable/ic_settings"
            android:background="@drawable/bg_icon_circle"
            android:padding="@dimen/space_10"
            android:tint="@color/primary"
            android:contentDescription="@string/anniversary_edit"
            android:layout_marginStart="@dimen/space_8" />

        <ImageButton
            android:id="@+id/btn_anni_delete"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:src="@drawable/ic_delete"
            android:background="@drawable/bg_icon_circle"
            android:padding="@dimen/space_10"
            android:tint="@color/status_error"
            android:contentDescription="@string/anniversary_delete"
            android:layout_marginStart="@dimen/space_4" />
    </LinearLayout>

    <!-- 第二行：倒计时/已在一起（全宽，避免长文案挤压布局） -->
    <TextView
        android:id="@+id/tv_anni_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/text_13"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/space_8"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>