<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- 任务内容 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/task_publish_hint_label"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_task_content"
            style="@style/Widget.EyeMonitor.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/task_publish_hint"
            android:maxLength="200"
            android:minHeight="46dp" />

        <!-- 奖励 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/task_reward_label"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 奖励：一行可横向滑动（singleLine + HorizontalScrollView） -->
        <HorizontalScrollView
            android:id="@+id/scroll_reward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_reward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:chipSpacingHorizontal="6dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_reward_0"
                    style="@style/Widget.EyeMonitor.Chip.Selectable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_reward_0" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_reward_1"
                    style="@style/Widget.EyeMonitor.Chip.Selectable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_reward_1" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_reward_2"
                    style="@style/Widget.EyeMonitor.Chip.Selectable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_reward_2" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_reward_3"
                    style="@style/Widget.EyeMonitor.Chip.Selectable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_reward_3" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_reward_4"
                    style="@style/Widget.EyeMonitor.Chip.Selectable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_reward_4" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_reward_5"
                    style="@style/Widget.EyeMonitor.Chip.Selectable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_reward_5" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <EditText
            android:id="@+id/et_task_reward_custom"
            style="@style/Widget.EyeMonitor.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/task_reward_custom_hint"
            android:maxLength="60"
            android:minHeight="40dp" />

        <!-- 配图预览（已选时显示缩略图） -->
        <ImageView
            android:id="@+id/iv_task_photo_thumb"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="10dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_media_placeholder"
            android:visibility="gone" />

        <!-- 配图 -->
        <LinearLayout
            android:id="@+id/ll_task_photo"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_image"
                android:tint="@color/primary" />

            <TextView
                android:id="@+id/tv_task_photo_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/task_add_photo"
                android:textColor="@color/primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
