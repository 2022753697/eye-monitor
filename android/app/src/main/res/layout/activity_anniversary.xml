<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 渐变头栏（统一 HeaderBar：渐变 std + 44dp 返回 + 20sp 居中标题 + 等宽动作槽） -->
    <include
        layout="@layout/component_header_bar"
        android:id="@+id/header_anniversary_bar" />

    <!-- 列表区（空的时显示 EmptyView） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_anniversaries"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false" />

        <!-- 空态（组件化） -->
        <include
            layout="@layout/component_empty_state"
            android:id="@+id/es_anniversary"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部添加按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:elevation="4dp"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_anniversary_add"
            style="@style/Widget.EyeMonitor.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/anniversary_add" />
    </LinearLayout>
</LinearLayout>