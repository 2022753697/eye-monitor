<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 渐变头栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header_gradient"
        android:padding="10dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_anniversary_back"
            style="@style/Widget.EyeMonitor.Button.Header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/anniversary_title"
            android:textColor="@color/text_on_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- 与返回按钮等宽的占位，保证标题视觉居中 -->
        <View
            android:layout_width="56dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- 列表区（空的时显示 EmptyView） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_anniversaries"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tv_anniversary_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/anniversary_empty"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部添加按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:elevation="4dp"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_anniversary_add"
            style="@style/Widget.EyeMonitor.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/anniversary_add" />
    </LinearLayout>
</LinearLayout>