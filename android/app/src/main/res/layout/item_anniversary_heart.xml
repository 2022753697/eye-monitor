<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="@dimen/icon_44"
        android:layout_height="@dimen/icon_44"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:layout_width="@dimen/icon_24"
            android:layout_height="@dimen/icon_24"
            android:layout_gravity="center"
            android:src="@drawable/ic_heart"
            android:contentDescription="@string/cd_anniversary" />

        <TextView
            android:id="@+id/tv_heart_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/text_11"
            android:textStyle="bold"
            android:maxLines="1"
            android:gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_heart_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_11"
        android:maxWidth="180dp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>