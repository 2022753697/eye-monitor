<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 头栏：返回 + 详情 + 编辑（统一 HeaderBar 视觉） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/bar_height_hero"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header_gradient_std"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btn_memo_detail_back"
            android:layout_width="@dimen/icon_44"
            android:layout_height="@dimen/icon_44"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="@color/white"
            android:background="@drawable/bg_header_icon"
            android:contentDescription="返回"
            style="?attr/borderlessButtonStyle" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/memo_detail_title"
            style="@style/TextAppearance.EyeMonitor.HeaderTitle"
            android:textColor="@color/white"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_memo_edit"
            style="@style/Widget.EyeMonitor.Button.HeaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/memo_edit" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 正文 -->
            <TextView
                android:id="@+id/tv_memo_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:lineSpacingExtra="4dp" />

            <!-- 图片条（本地路径横向排列） -->
            <LinearLayout
                android:id="@+id/ll_memo_detail_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- 子项 -->
            <LinearLayout
                android:id="@+id/ll_memo_detail_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp" />

            <!-- 信息行 -->
            <TextView
                android:id="@+id/tv_memo_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 删除 -->
            <TextView
                android:id="@+id/btn_memo_delete"
                style="@style/Widget.EyeMonitor.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="24dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:text="@string/memo_delete" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>