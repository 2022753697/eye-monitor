<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 第 1 行：清空聊天 / 打卡 / 纪念日 / 亲密度（与第 1 面板完全同构） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_14"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/grid_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_delete"
                android:background="@drawable/bg_icon_circle"
                android:padding="11dp"
                android:tint="@color/primary"
                android:contentDescription="@string/menu_clear_chat" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_clear_chat"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_12"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/grid_checkin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_check_in"
                android:background="@drawable/bg_icon_circle"
                android:padding="11dp"
                android:tint="@color/primary"
                android:contentDescription="@string/affection_check_in" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/affection_check_in"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_12"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/grid_anniversary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_heart"
                android:background="@drawable/bg_icon_circle"
                android:padding="11dp"
                android:tint="@color/primary"
                android:contentDescription="@string/anniversary_title" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/anniversary_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_12"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/grid_affection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_heart"
                android:background="@drawable/bg_icon_circle"
                android:padding="11dp"
                android:tint="@color/primary"
                android:contentDescription="@string/affection_section_title" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/affection_section_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_12"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第 2 行：搜索聊天记录 / 外观模式（与第 1 面板同构，两个格子自然并排） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/space_16"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/grid_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_search"
                android:background="@drawable/bg_icon_circle"
                android:padding="11dp"
                android:tint="@color/primary"
                android:contentDescription="@string/cd_chat_search" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cd_chat_search"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_12"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/grid_appearance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_appearance"
                android:background="@drawable/bg_icon_circle"
                android:padding="11dp"
                android:tint="@color/primary"
                android:contentDescription="@string/profile_appearance_section" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_appearance_section"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_12"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>