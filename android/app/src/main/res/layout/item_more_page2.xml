<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

        <!-- 第 2 页（含 v2 补位：纪念日 / 亲密度，替换原空占位） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_14"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_16">

        <LinearLayout
            android:id="@+id/grid_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_delete"
                android:background="@drawable/bg_icon_circle"
                android:padding="11dp"
                android:tint="@color/text_secondary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_clear_chat"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_12"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 打卡（三入口之一：更多面板） -->
        <LinearLayout
            android:id="@+id/grid_checkin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_check_in"
                android:background="@drawable/bg_icon_circle"
                android:padding="11dp"
                android:tint="@color/primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/affection_check_in"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_12"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- v2 §2.3 补位：纪念日入口（复用 anniversary_title + ic_heart） -->
        <LinearLayout
            android:id="@+id/grid_anniversary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_heart"
                android:background="@drawable/bg_icon_circle"
                android:padding="11dp"
                android:tint="@color/primary"
                android:contentDescription="@string/anniversary_title" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/anniversary_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_12"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- v2 §2.3 补位：亲密度（复用 profile_affection_section + ic_heart） -->
        <LinearLayout
            android:id="@+id/grid_affection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_heart"
                android:background="@drawable/bg_icon_circle"
                android:padding="11dp"
                android:tint="@color/primary"
                android:contentDescription="@string/profile_affection_section" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_affection_section"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_12"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Phase 4 深色模式：外观三态入口（跟随系统/浅色/深色）-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_16">

        <LinearLayout
            android:id="@+id/grid_appearance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_appearance"
                android:background="@drawable/bg_icon_circle"
                android:padding="11dp"
                android:tint="@color/primary"
                android:contentDescription="@string/profile_appearance_section" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_appearance_section"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_12"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>