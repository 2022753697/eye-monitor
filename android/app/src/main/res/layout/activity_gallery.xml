<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 内容区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- 渐变头栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header_gradient"
        android:padding="@dimen/space_16"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TextAppearance.EyeMonitor.HeaderTitle"
            android:text="@string/gallery_title" />
    </LinearLayout>

    <!-- 分类条移除：全部视图 = 文件夹卡片上下列表（每行一个文件夹），见 item_media_folder.xml -->

    <!-- 按天分组网格 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_gallery"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/space_4"
        android:clipToPadding="false" />

    <!-- 空状态：占满剩余区域并居中 -->
    <TextView
        android:id="@+id/tv_gallery_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/gallery_empty"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_14"
        android:visibility="gone" />

    <!-- 批量操作栏（选择模式底部） -->
    <LinearLayout
        android:id="@+id/batch_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card"
        android:padding="@dimen/space_8"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_batch_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_13" />

        <Button
            android:id="@+id/btn_batch_move"
            style="@style/Widget.EyeMonitor.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/batch_move" />

        <Button
            android:id="@+id/btn_batch_delete"
            style="@style/Widget.EyeMonitor.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/batch_delete" />

        <Button
            android:id="@+id/btn_batch_cancel"
            style="@style/Widget.EyeMonitor.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/batch_cancel" />
    </LinearLayout>
    </LinearLayout>

    <!-- 新建文件夹：右下角悬浮按钮（全部视图）· 点按展开/收回扇形菜单 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_folder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_16"
        android:contentDescription="@string/gallery_more_actions"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary"
        app:tint="@color/white"
        app:rippleColor="@color/white_translucent"
        app:elevation="4dp" />

    <!-- 扇形气泡菜单：子项初始叠放在 FAB 位置（margin 同 FAB），
         展开时用三角函数计算左上方扇形目标坐标，ObjectAnimator 从 FAB 中心散开。
         气泡 = 椭圆造型（两字项为圆 52dp，新建文件夹为胖椭圆 96x52），文字内敛不溢出 -->
    <TextView
        android:id="@+id/btn_gallery_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_16"
        android:background="@drawable/bg_bubble_menu"
        android:elevation="3dp"
        android:gravity="center"
        android:minWidth="52dp"
        android:minHeight="52dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/back"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/btn_gallery_upload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_16"
        android:background="@drawable/bg_bubble_menu"
        android:elevation="3dp"
        android:gravity="center"
        android:minWidth="52dp"
        android:minHeight="52dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/gallery_upload"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/btn_gallery_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_16"
        android:background="@drawable/bg_bubble_menu"
        android:elevation="3dp"
        android:gravity="center"
        android:minWidth="52dp"
        android:minHeight="52dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/gallery_select"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/btn_menu_new_folder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_16"
        android:background="@drawable/bg_bubble_menu"
        android:elevation="3dp"
        android:gravity="center"
        android:minWidth="56dp"
        android:minHeight="56dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/gallery_folder_new_bubble"
        android:lineSpacingExtra="0dp"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="invisible" />
</FrameLayout>