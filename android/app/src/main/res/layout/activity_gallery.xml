<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 渐变头栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header_gradient"
        android:padding="@dimen/space_16"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TextAppearance.EyeMonitor.HeaderTitle"
            android:text="@string/gallery_title" />

        <Button
            android:id="@+id/btn_gallery_select"
            style="@style/Widget.EyeMonitor.Button.HeaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            android:text="@string/gallery_select" />

        <Button
            android:id="@+id/btn_gallery_upload"
            style="@style/Widget.EyeMonitor.Button.HeaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            android:text="@string/gallery_upload" />

        <Button
            android:id="@+id/btn_gallery_back"
            style="@style/Widget.EyeMonitor.Button.HeaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back" />
    </LinearLayout>

    <!-- 分类条移除：全部视图 = 文件夹卡片上下列表（每行一个文件夹），见 item_media_folder.xml -->

    <!-- 按天分组网格 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_gallery"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/space_4"
        android:clipToPadding="false" />

    <!-- 空状态：占满剩余区域并居中 -->
    <TextView
        android:id="@+id/tv_gallery_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/gallery_empty"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_14"
        android:visibility="gone" />

    <!-- 批量操作栏（选择模式底部） -->
    <LinearLayout
        android:id="@+id/batch_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card"
        android:padding="@dimen/space_8"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_batch_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_13" />

        <Button
            android:id="@+id/btn_batch_move"
            style="@style/Widget.EyeMonitor.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/batch_move" />

        <Button
            android:id="@+id/btn_batch_delete"
            style="@style/Widget.EyeMonitor.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/batch_delete" />

        <Button
            android:id="@+id/btn_batch_cancel"
            style="@style/Widget.EyeMonitor.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/batch_cancel" />
    </LinearLayout>
</LinearLayout>