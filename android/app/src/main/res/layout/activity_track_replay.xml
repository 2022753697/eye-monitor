<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 地图（全屏） -->
    <com.amap.api.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部渐变头栏（v2 §2.13：统一 HeaderBar include，浮层定位保留） -->
    <include
        layout="@layout/component_header_bar"
        android:id="@+id/header_track_replay_bar"
        android:layout_gravity="top" />

    <!-- 底部控制面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/shadow_2"
        android:padding="@dimen/space_12"
        android:layout_gravity="bottom">

        <!-- 行1：时间段选择（今天 / 近7天 / 自定义） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_range_today"
                style="@style/Widget.EyeMonitor.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/track_range_today"
                android:textSize="@dimen/text_13"
                android:minWidth="0dp"
                android:layout_marginEnd="@dimen/space_4" />

            <Button
                android:id="@+id/btn_range_7d"
                style="@style/Widget.EyeMonitor.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/track_range_7d"
                android:textSize="@dimen/text_13"
                android:minWidth="0dp"
                android:layout_marginEnd="@dimen/space_4" />

            <Button
                android:id="@+id/btn_range_custom"
                style="@style/Widget.EyeMonitor.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/track_range_custom"
                android:textSize="@dimen/text_13"
                android:minWidth="0dp" />
        </LinearLayout>

        <!-- 行2：播放/暂停 + 倍速 + 进度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_10"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_play_pause"
                style="@style/Widget.EyeMonitor.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/bar_height"
                android:layout_weight="1"
                android:text="@string/track_play"
                android:textSize="@dimen/text_15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_speed_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_13"
                android:layout_marginStart="@dimen/space_12" />

            <Button
                android:id="@+id/btn_speed"
                style="@style/Widget.EyeMonitor.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/track_speed_one"
                android:textSize="@dimen/text_14"
                android:minWidth="0dp"
                android:paddingStart="@dimen/space_14"
                android:paddingEnd="@dimen/space_14"
                android:layout_marginStart="@dimen/space_8" />

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/track_loading"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_13"
                android:gravity="end"
                android:layout_marginStart="@dimen/space_12" />
        </LinearLayout>
    </LinearLayout>

    <!-- 空态浮层（v2 §2.13：地图中央；数据为空时替换 Toast 展示，点按可关闭） -->
    <include
        layout="@layout/component_empty_state"
        android:id="@+id/es_track_replay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
