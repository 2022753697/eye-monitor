<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 地图（全屏） -->
    <com.amap.api.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部渐变头栏：返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header_gradient"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_gravity="top">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_icon_circle"
            android:padding="10dp"
            android:tint="@color/text_on_primary"
            android:contentDescription="@string/back" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/track_replay_title"
            android:textColor="@color/text_on_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- 底部控制面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        android:padding="12dp"
        android:layout_gravity="bottom">

        <!-- 行1：时间段选择（今天 / 近7天 / 自定义） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_range_today"
                style="@style/Widget.EyeMonitor.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/track_range_today"
                android:textSize="13sp"
                android:minWidth="0dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_range_7d"
                style="@style/Widget.EyeMonitor.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/track_range_7d"
                android:textSize="13sp"
                android:minWidth="0dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_range_custom"
                style="@style/Widget.EyeMonitor.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/track_range_custom"
                android:textSize="13sp"
                android:minWidth="0dp" />
        </LinearLayout>

        <!-- 行2：播放/暂停 + 倍速 + 进度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_play_pause"
                style="@style/Widget.EyeMonitor.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="@string/track_play"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_speed_label"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginStart="12dp" />

            <Button
                android:id="@+id/btn_speed"
                style="@style/Widget.EyeMonitor.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/track_speed_one"
                android:textSize="14sp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/track_loading"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="end"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
