<?xml version="1.0" encoding="utf-8"?>
<!-- 权限中心（由原 MonitorActivity 改造）：App 所需权限一览 + 状态 + 点击请求/跳转 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 统一头栏（v2 §2.12：std 渐变 + icon 返回 + 标题「权限设置」20sp 居中） -->
    <include
        layout="@layout/component_header_bar"
        android:id="@+id/header_permission_bar" />

    <!-- 内容区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.EyeMonitor.Label"
                android:text="@string/permission_tip"
                android:paddingBottom="@dimen/space_12" />

            <!-- 通知 -->
            <LinearLayout
                android:id="@+id/row_perm_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perm_notification"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_15" />

                    <TextView
                        android:id="@+id/tv_perm_notification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/status_warn_text"
                        android:textSize="@dimen/text_13" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_notification_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_12"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <!-- 位置（含后台） -->
            <LinearLayout
                android:id="@+id/row_perm_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perm_location"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_15" />

                    <TextView
                        android:id="@+id/tv_perm_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/status_warn_text"
                        android:textSize="@dimen/text_13" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_location_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_12"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <!-- 录音 -->
            <LinearLayout
                android:id="@+id/row_perm_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perm_audio"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_15" />

                    <TextView
                        android:id="@+id/tv_perm_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/status_warn_text"
                        android:textSize="@dimen/text_13" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_audio_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_12"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <!-- 蓝牙 -->
            <LinearLayout
                android:id="@+id/row_perm_bluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perm_bluetooth"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_15" />

                    <TextView
                        android:id="@+id/tv_perm_bluetooth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/status_warn_text"
                        android:textSize="@dimen/text_13" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_bluetooth_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_12"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <!-- 使用情况访问 -->
            <LinearLayout
                android:id="@+id/row_perm_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perm_usage"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_15" />

                    <TextView
                        android:id="@+id/tv_perm_usage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/status_warn_text"
                        android:textSize="@dimen/text_13" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_usage_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_12"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <!-- 无障碍（可选） -->
            <LinearLayout
                android:id="@+id/row_perm_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perm_accessibility"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_15" />

                    <TextView
                        android:id="@+id/tv_perm_accessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/status_warn_text"
                        android:textSize="@dimen/text_13" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_accessibility_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_12"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <!-- 电池优化白名单 -->
            <LinearLayout
                android:id="@+id/row_perm_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perm_battery"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_15" />

                    <TextView
                        android:id="@+id/tv_perm_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/status_warn_text"
                        android:textSize="@dimen/text_13" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_battery_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_12"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <!-- 开机自启 -->
            <LinearLayout
                android:id="@+id/row_perm_boot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/perm_boot"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_15" />

                    <TextView
                        android:id="@+id/tv_perm_boot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_13" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_boot_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_12"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>