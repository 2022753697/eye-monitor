<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_16"
    android:paddingEnd="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_8">

    <TextView
        style="@style/TextAppearance.EyeMonitor.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_permission_hint_message"
        android:textColor="@color/text_secondary" />

    <!-- 使用情况访问权限 -->
    <LinearLayout
        android:id="@+id/row_guide_usage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:paddingTop="@dimen/space_14"
        android:paddingBottom="@dimen/space_14"
        android:layout_marginTop="@dimen/space_8">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/guide_row_usage"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_15" />

        <!-- 未开启=空心圈；开启=珊瑚圈+√ -->
        <TextView
            android:id="@+id/tv_guide_usage_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_select_badge_off"
            android:gravity="center"
            android:textColor="@color/text_on_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 无障碍服务 -->
    <LinearLayout
        android:id="@+id/row_guide_accessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:paddingTop="@dimen/space_14"
        android:paddingBottom="@dimen/space_14">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/guide_row_accessibility"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_15" />

        <TextView
            android:id="@+id/tv_guide_accessibility_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_select_badge_off"
            android:gravity="center"
            android:textColor="@color/text_on_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/guide_done_tip"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
</LinearLayout>