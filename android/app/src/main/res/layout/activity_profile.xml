<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 统一头栏（v2 §2.4：std 渐变 + icon 返回 + 标题「我的主页」20sp 居中） -->
    <include
        layout="@layout/component_header_bar"
        android:id="@+id/header_profile_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- 头像 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="@dimen/space_16">

                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:layout_gravity="center"
                    android:src="@drawable/avatar_female"
                    android:contentDescription="@string/profile_avatar_hint"
                    android:background="@drawable/bg_avatar_ring"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <!-- 编辑卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_nickname_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_14"
                    android:layout_marginBottom="@dimen/space_8" />

                <EditText
                    android:id="@+id/et_profile_nickname"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bar_height"
                    android:inputType="text"
                    android:maxLength="32"
                    android:layout_marginBottom="@dimen/space_16" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_gender_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_14"
                    android:layout_marginBottom="@dimen/space_8" />

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/space_16">

                    <RadioButton
                        android:id="@+id/rb_profile_female"
                        style="@style/Widget.EyeMonitor.RadioButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="@string/gender_option_female"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/rb_profile_male"
                        style="@style/Widget.EyeMonitor.RadioButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/gender_option_male"
                        android:textColor="@color/text_primary" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_birthday_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_14"
                    android:layout_marginBottom="@dimen/space_8" />

                <EditText
                    android:id="@+id/et_profile_birthday"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bar_height"
                    android:hint="@string/profile_birthday_hint"
                    android:inputType="datetime"
                    android:maxLength="10"
                    android:layout_marginBottom="@dimen/space_16" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_bio_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_14"
                    android:layout_marginBottom="@dimen/space_8" />

                <EditText
                    android:id="@+id/et_profile_bio"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/profile_bio_hint"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:maxLines="4"
                    android:maxLength="60" />

                <!-- 服务器地址（WS3：Tailscale 部署后免重打包切换，AC4） -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="@dimen/space_16" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_server_url_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_14"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="@dimen/space_4" />

                <LinearLayout
                    android:id="@+id/row_server_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="@dimen/space_10">

                    <TextView
                        android:id="@+id/tv_server_url_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/server_url_placeholder"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_14"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_server_url_change"
                        android:textColor="@color/primary_text"
                        android:textSize="@dimen/text_14" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_profile_save"
                    style="@style/Widget.EyeMonitor.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bar_height"
                    android:text="@string/profile_save"
                    android:layout_marginTop="@dimen/space_16" />
            </LinearLayout>

            <!-- ============ 好感度：等级详情区 ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="@dimen/space_16"
                android:layout_marginTop="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_12">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_heart"
                        android:tint="@color/primary"
                        android:contentDescription="@string/profile_affection_section" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.EyeMonitor.Title"
                        android:text="@string/profile_affection_section"
                        android:layout_marginStart="@dimen/space_8" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_aff_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.EyeMonitor.Display"
                    android:textSize="@dimen/text_28"
                    android:textColor="@color/primary_text" />

                <TextView
                    android:id="@+id/tv_aff_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.EyeMonitor.Title"
                    android:textColor="@color/accent_text"
                    android:layout_marginTop="2dp" />

                <ProgressBar
                    android:id="@+id/progress_affection_profile"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:progressTint="@color/primary"
                    android:progressBackgroundTint="@color/divider"
                    android:max="100"
                    android:progress="0"
                    android:layout_marginTop="@dimen/space_10" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/space_8">

                    <TextView
                        android:id="@+id/tv_aff_points"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/TextAppearance.EyeMonitor.Label" />

                    <TextView
                        android:id="@+id/tv_aff_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.EyeMonitor.Label" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_aff_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.EyeMonitor.Label"
                    android:gravity="center"
                    android:padding="@dimen/space_16"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ============ 好感度：周互动对比卡 ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="@dimen/space_16"
                android:layout_marginTop="@dimen/space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.EyeMonitor.Title"
                    android:text="@string/profile_week_section"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.EyeMonitor.Label"
                    android:textColor="@color/text_tertiary"
                    android:text="@string/profile_week_note"
                    android:layout_marginBottom="@dimen/space_8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_8">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/TextAppearance.EyeMonitor.Body"
                        android:text="@string/profile_week_chats" />

                    <TextView
                        android:id="@+id/tv_week_chats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.EyeMonitor.Body"
                        android:textColor="@color/primary_text" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_8">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/TextAppearance.EyeMonitor.Body"
                        android:text="@string/profile_week_checkins" />

                    <TextView
                        android:id="@+id/tv_week_checkins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.EyeMonitor.Body"
                        android:textColor="@color/primary_text" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_8">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/TextAppearance.EyeMonitor.Body"
                        android:text="@string/profile_week_online" />

                    <TextView
                        android:id="@+id/tv_week_online"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.EyeMonitor.Body"
                        android:textColor="@color/accent_text" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 好感度：装扮区（主题选择，本地偏好） ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="@dimen/space_16"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/TextAppearance.EyeMonitor.Title"
                        android:text="@string/profile_theme_section" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.EyeMonitor.Label"
                        android:text="@string/profile_theme_hint" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_theme_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/space_12" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>