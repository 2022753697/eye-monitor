<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 渐变头栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header_gradient"
        android:padding="@dimen/space_16"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TextAppearance.EyeMonitor.HeaderTitle"
            android:text="@string/profile_title" />

        <Button
            android:id="@+id/btn_profile_back"
            style="@style/Widget.EyeMonitor.Button.Header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- 头像 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="@dimen/space_16">

                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:layout_gravity="center"
                    android:src="@drawable/avatar_female"
                    android:contentDescription="@string/profile_avatar_hint"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </FrameLayout>

            <!-- 编辑卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_nickname_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_14"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_profile_nickname"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bar_height"
                    android:inputType="text"
                    android:maxLength="32"
                    android:layout_marginBottom="@dimen/space_16" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_gender_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_14"
                    android:layout_marginBottom="6dp" />

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/space_16">

                    <RadioButton
                        android:id="@+id/rb_profile_female"
                        style="@style/Widget.EyeMonitor.RadioButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="@string/gender_option_female"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/rb_profile_male"
                        style="@style/Widget.EyeMonitor.RadioButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/gender_option_male"
                        android:textColor="@color/text_primary" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_birthday_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_14"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_profile_birthday"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bar_height"
                    android:hint="@string/profile_birthday_hint"
                    android:inputType="datetime"
                    android:maxLength="10"
                    android:layout_marginBottom="@dimen/space_16" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_bio_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_14"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_profile_bio"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/profile_bio_hint"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:maxLines="4"
                    android:maxLength="60" />

                <!-- 服务器地址（WS3：Tailscale 部署后免重打包切换，AC4） -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="@dimen/space_16" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_server_url_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_14"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/row_server_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tv_server_url_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/server_url_placeholder"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_14"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_server_url_change"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_14" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_profile_save"
                    style="@style/Widget.EyeMonitor.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bar_height"
                    android:text="@string/profile_save"
                    android:layout_marginTop="@dimen/space_16" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>