<?xml version="1.0" encoding="utf-8"?>
<!-- 新建文件夹弹窗：圆角白卡 + 设计令牌（与页面同源样式） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="@dimen/space_24">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.EyeMonitor.Display"
        android:gravity="center"
        android:text="@string/gallery_folder_new"
        android:layout_marginBottom="@dimen/space_16" />

    <!-- 文件夹名称输入 -->
    <EditText
        android:id="@+id/et_folder_name"
        style="@style/Widget.EyeMonitor.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/gallery_folder_new_hint"
        android:inputType="text"
        android:maxLength="24"
        android:singleLine="true"
        android:imeOptions="actionDone" />

    <!-- 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/space_16">

        <Button
            android:id="@+id/btn_folder_cancel"
            style="@style/Widget.EyeMonitor.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/btn_folder_ok"
            style="@style/Widget.EyeMonitor.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_12"
            android:text="@string/gallery_folder_create" />
    </LinearLayout>
</LinearLayout>