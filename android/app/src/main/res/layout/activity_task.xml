<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 头栏：标题 + 发布按钮（统一 HeaderBar 视觉） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/bar_height_hero"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header_gradient_std"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btn_task_back"
            android:layout_width="@dimen/icon_44"
            android:layout_height="@dimen/icon_44"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="@color/white"
            android:background="@drawable/bg_header_icon"
            android:contentDescription="@string/cd_back"
            style="?attr/borderlessButtonStyle" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/task_my_tasks"
            style="@style/TextAppearance.EyeMonitor.HeaderTitle"
            android:textColor="@color/white"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_task_publish"
            style="@style/Widget.EyeMonitor.Button.HeaderAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/task_publish" />
    </LinearLayout>

    <!-- 筛选 chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_task_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/space_8" />
    </HorizontalScrollView>

    <!-- 任务列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_16" />

    <!-- 空态（组件化） -->
    <include
        layout="@layout/component_empty_state"
        android:id="@+id/es_task"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>
