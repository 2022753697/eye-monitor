<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 地图（全屏） -->
    <com.amap.api.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部双头像胶囊（微信共享地址风格，点击弹菜单） -->
    <LinearLayout
        android:id="@+id/top_avatar_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_top_card"
        android:elevation="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="16dp">

        <ImageView
            android:id="@+id/iv_avatar_self"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/avatar_female"
            android:contentDescription="我的位置" />

        <ImageView
            android:id="@+id/iv_avatar_peer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/avatar_female"
            android:contentDescription="对方位置"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <!-- 头像下小菜单（点头像弹出：去找他 / 设围栏），默认隐藏 -->
    <LinearLayout
        android:id="@+id/top_tools_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="86dp"
        android:visibility="gone">

        <!-- 图标+文字：去找他（蓝色导航图标） -->
        <LinearLayout
            android:id="@+id/btn_menu_peer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_go_peer"
                android:contentDescription="@string/menu_go_to_peer"
                android:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_go_to_peer"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:background="@color/text_secondary"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <!-- 图标+文字：设围栏（圈定范围图标） -->
        <LinearLayout
            android:id="@+id/btn_menu_set_fence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_fence"
                android:contentDescription="@string/fence_set_entry"
                android:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fence_set_entry"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 设围栏面板（进入设围栏模式后显示） -->
    <LinearLayout
        android:id="@+id/fence_setup_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:visibility="gone"
        android:padding="@dimen/space_16"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/space_12">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fence_panel_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_16"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fence_center_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/fence_hint_pick_center"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_13" />

        <SeekBar
            android:id="@+id/fence_radius_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginTop="@dimen/space_4" />

        <TextView
            android:id="@+id/fence_radius_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_13" />

        <EditText
            android:id="@+id/fence_name_input"
            style="@style/Widget.EyeMonitor.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:inputType="text"
            android:maxLength="20"
            android:hint="@string/fence_name_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_12">

            <Button
                android:id="@+id/fence_cancel_btn"
                style="@style/Widget.EyeMonitor.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/fence_cancel" />

            <Space
                android:layout_width="@dimen/space_12"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/fence_confirm_btn"
                style="@style/Widget.EyeMonitor.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/fence_confirm" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
