<?xml version="1.0" encoding="utf-8"?>
<!-- 自己文本气泡：右对齐；结构=已撤回系统行 → 引用条 → 气泡 → 时间行(下方右对齐) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:paddingStart="60dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- 已撤回系统提示（居中灰字，撤回后替代气泡） -->
    <TextView
        android:id="@+id/tv_recalled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 引用回复条（引用后显示，点击定位到原消息） -->
    <TextView
        android:id="@+id/tv_chat_ref"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="200dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/bg_quote_ref"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_chat_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_self"
        android:textColor="@color/text_on_primary"
        android:textSize="15sp"
        android:lineSpacingExtra="2dp"
        android:padding="12dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp">

        <TextView
            android:id="@+id/tv_chat_read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_read_label"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:layout_marginEnd="2dp"
            android:visibility="gone" />

        <!-- 未送达（发送失败，点击重发） -->
        <TextView
            android:id="@+id/tv_send_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_send_failed"
            android:textColor="@color/status_error"
            android:textSize="10sp"
            android:layout_marginEnd="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_chat_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>