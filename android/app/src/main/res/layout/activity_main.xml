<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ================= 配对面板（未配对时显示） ================= -->
    <LinearLayout
        android:id="@+id/view_pair_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background">

        <!-- 渐变头栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_gradient"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_title"
                android:textColor="@color/text_on_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_subtitle"
                android:textColor="@color/text_on_primary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 配对卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pair_input_card_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/et_pair_code"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/pair_code_hint"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_join_pair"
                    style="@style/Widget.EyeMonitor.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_confirm_pair"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_create_pair"
                    style="@style/Widget.EyeMonitor.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_create_pair_code" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= 聊天面板（已配对时显示） ================= -->
    <LinearLayout
        android:id="@+id/view_chat_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background"
        android:visibility="gone">

        <!-- 渐变头栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_header_gradient"
            android:padding="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_chat_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_title_default"
                    android:textColor="@color/text_on_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SOS 紧急求助（长按 3 秒触发） -->
            <ImageButton
                android:id="@+id/btn_sos"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_sos"
                android:background="@drawable/bg_icon_circle"
                android:padding="12dp"
                android:tint="@color/status_error"
                android:contentDescription="@string/sos_alert_entrance_desc"
                android:layout_marginEnd="8dp" />

            <!-- 共享地图（图标 + 文字） -->
            <LinearLayout
                android:id="@+id/btn_chat_map"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_btn_white_rect"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_map"
                    android:tint="@color/text_on_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_share_map"
                    android:textColor="@color/text_on_primary"
                    android:textSize="13sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 消息列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

        <!-- 底部容器：输入栏 + 更多面板（一起滑入滑出） -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">



        <!-- 底部输入栏：输入框 + 发送 + 更多（一组，QQ 风格） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:elevation="4dp"
            android:padding="8dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_chat_input"
                style="@style/Widget.EyeMonitor.EditText"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:hint="@string/chat_hint_input"
                android:textSize="15sp"
                android:maxLines="4"
                android:inputType="textMultiLine" />

            <!-- 发送（无输入灰色 / 有输入粉色） -->
            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_send"
                android:background="@drawable/bg_icon_circle"
                android:padding="12dp"
                android:contentDescription="@string/btn_send"
                android:layout_marginStart="8dp" />

            <!-- 更多（底部弹出菜单） -->
            <ImageButton
                android:id="@+id/btn_chat_more"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_more"
                android:background="@drawable/bg_icon_circle"
                android:padding="14dp"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/menu_more"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- 更多面板（QQ 风格网格，弹出时占底部、顶起输入栏） -->
        <include
            android:id="@+id/more_panel"
            layout="@layout/view_more_panel"
            android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
