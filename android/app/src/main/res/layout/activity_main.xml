<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ================= 配对面板（未配对时显示） ================= -->
    <LinearLayout
        android:id="@+id/view_pair_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background">

        <!-- 渐变头栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_gradient"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_title"
                android:textColor="@color/text_on_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_subtitle"
                android:textColor="@color/text_on_primary"
                android:textSize="@dimen/text_13"
                android:layout_marginTop="@dimen/space_4" />
        </LinearLayout>

        <!-- 配对卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/space_16"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="@dimen/space_24">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pair_input_card_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_15"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/space_16" />

                <EditText
                    android:id="@+id/et_pair_code"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bar_height"
                    android:hint="@string/pair_code_hint"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textSize="@dimen/text_16"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/space_12" />

                <Button
                    android:id="@+id/btn_join_pair"
                    style="@style/Widget.EyeMonitor.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bar_height"
                    android:text="@string/btn_confirm_pair"
                    android:layout_marginBottom="@dimen/space_12" />

                <Button
                    android:id="@+id/btn_create_pair"
                    style="@style/Widget.EyeMonitor.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bar_height"
                    android:text="@string/btn_create_pair_code" />

                <TextView
                    android:id="@+id/tv_pair_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_14"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_12"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= 聊天面板（已配对时显示） ================= -->
    <FrameLayout
        android:id="@+id/view_chat_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:visibility="gone">

        <!-- 内容列（头栏/消息/底栏不因爱心占位而位移） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- 渐变头栏（v2 §2.1：三行 → 两行 ≈76dp。行A=标题+纯图标钮 / 行B=紧凑状态行 / 底部 scrim 压暗带） -->
        <LinearLayout
            android:id="@+id/chat_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_gradient">

            <!-- 行 A：标题 20sp + 好感度徽章（左）｜ 地图/图库纯图标钮 44dp 热区 ×2（右） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:paddingTop="@dimen/space_10">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tv_chat_title"
                android:shadowColor="@color/shadow_title"
                android:shadowRadius="5"
                android:shadowDy="1.5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chat_title_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:textColor="@color/text_on_primary"
                        android:textSize="@dimen/text_20"
                        android:textStyle="bold" />

                    <!-- 好感度/等级徽章：与名称同行（名称右侧），点击进资料页等级详情 -->
                    <LinearLayout
                        android:id="@+id/affection_badge_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingEnd="4dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/iv_affection_badge"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_heart"
                            android:tint="@color/text_on_primary"
                            android:contentDescription="@string/cd_affection_badge" />

                        <TextView
                            android:id="@+id/tv_affection_title"
                            android:shadowColor="@color/shadow_title"
                            android:shadowRadius="4"
                            android:shadowDy="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_on_primary_muted"
                            android:textSize="@dimen/text_10"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 对方正在输入…（typing 事件时显示 3s；并入行 A 左列，维持隐藏态逻辑） -->
                <TextView
                    android:id="@+id/tv_typing_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_typing_hint"
                    android:textColor="@color/text_on_primary"
                    android:textSize="@dimen/text_12"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 消息搜索（Phase 5：头栏图标 → SearchActivity） -->
            <LinearLayout
                android:id="@+id/btn_chat_search"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_btn_white_rect"
                android:layout_marginStart="@dimen/space_8"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_chat_search">

                <ImageView
                    android:layout_width="@dimen/icon_20"
                    android:layout_height="@dimen/icon_20"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_on_primary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- 共享地图（v2：纯图标 44dp 热区，图形 20dp 视觉，白 30% 圆底 radius_md；ID/点击回调不动） -->
            <LinearLayout
                android:id="@+id/btn_chat_map"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_btn_white_rect"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_btn_map">

                <ImageView
                    android:id="@+id/iv_icon_map"
                    android:layout_width="@dimen/icon_20"
                    android:layout_height="@dimen/icon_20"
                    android:src="@drawable/ic_map"
                    android:tint="@color/text_on_primary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- 共享图库（v2：纯图标 44dp 热区，图形 20dp 视觉，白 30% 圆底 radius_md；ID/点击回调不动） -->
            <LinearLayout
                android:id="@+id/btn_chat_gallery"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_btn_white_rect"
                android:layout_marginStart="@dimen/space_8"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_btn_gallery">

                <ImageView
                    android:id="@+id/iv_icon_gallery"
                    android:layout_width="@dimen/icon_20"
                    android:layout_height="@dimen/icon_20"
                    android:src="@drawable/ic_gallery"
                    android:tint="@color/text_on_primary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- 主题装饰（狗狗乐园：爪印，默认主题隐藏） -->
            <ImageView
                android:id="@+id/iv_header_decor"
                android:layout_width="@dimen/icon_18"
                android:layout_height="@dimen/icon_18"
                android:src="@drawable/ic_paw_white"
                android:contentDescription="@string/cd_header_decor"
                android:layout_marginStart="@dimen/space_8"
                android:visibility="gone" />
            </LinearLayout>

            <!-- 行 B：状态行紧凑单行（图标 10×13/8×10、text_11 + text_on_primary_muted、margin 2dp、段间 ·；点击进详情页） -->
            <LinearLayout
                android:id="@+id/peer_status_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/space_2"
                android:layout_marginStart="@dimen/space_14"
                android:paddingEnd="@dimen/space_4"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/iv_peer_battery"
                    android:layout_width="10dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_battery_lv2"
                    android:contentDescription="@string/cd_battery" />

                <TextView
                    android:id="@+id/tv_peer_battery_pct"
                    android:shadowColor="@color/shadow_status"
                    android:shadowRadius="3"
                    android:shadowDy="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_on_primary_muted"
                    android:textSize="@dimen/text_11"
                    android:layout_marginStart="@dimen/space_2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="·"
                    android:textColor="@color/text_on_primary_muted"
                    android:textSize="@dimen/text_11"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_marginEnd="@dimen/space_2" />

                <ImageView
                    android:id="@+id/iv_peer_charging"
                    android:layout_width="8dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_charging_off"
                    android:contentDescription="@string/cd_charging"
                    android:layout_marginStart="@dimen/space_2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="·"
                    android:textColor="@color/text_on_primary_muted"
                    android:textSize="@dimen/text_11"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_marginEnd="@dimen/space_2" />

                <TextView
                    android:id="@+id/tv_peer_network"
                    android:shadowColor="@color/shadow_status"
                    android:shadowRadius="3"
                    android:shadowDy="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_on_primary_muted"
                    android:textSize="@dimen/text_11"
                    android:layout_marginStart="@dimen/space_2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="·"
                    android:textColor="@color/text_on_primary_muted"
                    android:textSize="@dimen/text_11"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_marginEnd="@dimen/space_2" />

                <ImageView
                    android:id="@+id/iv_peer_bluetooth"
                    android:layout_width="8dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_bluetooth_off"
                    android:contentDescription="@string/cd_bluetooth"
                    android:layout_marginStart="@dimen/space_2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="·"
                    android:textColor="@color/text_on_primary_muted"
                    android:textSize="@dimen/text_11"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_marginEnd="@dimen/space_2" />

                <TextView
                    android:id="@+id/tv_peer_online"
                    android:shadowColor="@color/shadow_status"
                    android:shadowRadius="3"
                    android:shadowDy="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_on_primary_muted"
                    android:textSize="@dimen/text_11"
                    android:layout_marginStart="@dimen/space_2" />
            </LinearLayout>

            <!-- scrim 微压暗带（v2：bg_header_scrim 渐变透明→10% 黑，兜底 11sp 微文本对比残差） -->
            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:background="@drawable/bg_header_scrim" />
        </LinearLayout>


        <!-- 消息列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="@dimen/space_56"
            android:paddingBottom="@dimen/space_8"
            android:clipToPadding="false" />

        <!-- 底部容器：输入栏 + 更多面板（一起滑入滑出） -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- 引用回复条（选择引用后出现，消息发送后消失） -->
        <LinearLayout
            android:id="@+id/ll_quote_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_quote_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/btn_quote_cancel"
                android:layout_width="@dimen/icon_44"
                android:layout_height="@dimen/icon_44"
                android:src="@drawable/ic_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/cancel" />
        </LinearLayout>



        <!-- 录音浮动条（按压录音时显示：松开发送 · 滑到取消放弃） -->
            <LinearLayout
                android:id="@+id/ll_record_panel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/bar_height_compact"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@color/surface"
                android:elevation="@dimen/shadow_2"
                android:visibility="gone">

            <TextView
                android:id="@+id/tv_record_hint"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/voice_release_to_send"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_record_cancel"
                android:layout_width="90dp"
                android:layout_height="@dimen/bar_height_compact"
                android:layout_marginEnd="@dimen/space_12"
                android:gravity="center"
                android:text="@string/voice_cancel"
                android:textColor="@color/status_error"
                android:textSize="15sp"
                android:background="@drawable/bg_record_cancel" />
        </LinearLayout>

        <!-- 底部输入栏：语音切换 + 输入框/按住说话 + 表情 + 媒体 + 发送 + 更多（微信式） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:elevation="@dimen/shadow_2"
            android:padding="@dimen/space_8"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="@dimen/icon_44"
                android:layout_height="@dimen/icon_44"
                android:padding="4dp"
                android:src="@drawable/ic_mic"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/voice_toggle"
                android:layout_marginEnd="@dimen/space_4" />

            <EditText
                android:id="@+id/et_chat_input"
                style="@style/Widget.EyeMonitor.EditText"
                android:layout_width="0dp"
                android:layout_height="@dimen/bar_height_compact"
                android:layout_weight="1"
                android:hint="@string/chat_hint_input"
                android:textSize="15sp"
                android:maxLines="4"
                android:inputType="textMultiLine" />

            <!-- 按住说话（语音模式时替代输入框） -->
            <TextView
                android:id="@+id/tv_voice_bar"
                android:layout_width="0dp"
                android:layout_height="@dimen/bar_height_compact"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_voice_bar"
                android:text="@string/voice_hold_hint"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_emoji"
                android:layout_width="@dimen/icon_44"
                android:layout_height="@dimen/icon_44"
                android:padding="4dp"
                android:src="@drawable/ic_emoji"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/chat_tool_emoji"
                android:layout_marginStart="@dimen/space_4" />

            <!-- 发送（无输入灰色 / 有输入粉色） -->
            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="@dimen/icon_44"
                android:layout_height="@dimen/icon_44"
                android:src="@drawable/ic_send"
                android:background="@drawable/bg_icon_circle"
                android:padding="11dp"
                android:contentDescription="@string/btn_send"
                android:layout_marginStart="@dimen/space_4" />

            <!-- 更多（底部弹出菜单） -->
            <ImageButton
                android:id="@+id/btn_chat_more"
                android:layout_width="@dimen/icon_44"
                android:layout_height="@dimen/icon_44"
                android:src="@drawable/ic_more"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/menu_more"
                android:layout_marginStart="@dimen/space_2" />
        </LinearLayout>

        <!-- 更多面板（QQ 风格网格，弹出时占底部、顶起输入栏） -->
        <include
            android:id="@+id/more_panel"
            layout="@layout/view_more_panel"
            android:visibility="gone" />

        <!-- 表情面板（微信式底部上滑） -->
        <include
            android:id="@+id/emoji_panel"
            layout="@layout/view_emoji_panel"
            android:visibility="gone" />
        </LinearLayout>
        </LinearLayout>

        <!-- 纪念日：爱心悬浮叠层，居头栏与内容区接缝正中（图标固定，左右滑动切换数字/名称） -->
        <LinearLayout
            android:id="@+id/view_anniversary_heart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="44dp"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:id="@+id/iv_anniversary_heart"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_heart"
                    android:contentDescription="@string/cd_anniversary" />

                <TextView
                    android:id="@+id/tv_anniversary_heart_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:gravity="center" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_anniversary_heart_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_11"
                android:maxWidth="200dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- 空态插图（狗狗乐园主题：聊天记录为空时显示，默认隐藏） -->
        <ImageView
            android:id="@+id/iv_chat_empty_state"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:contentDescription="@string/chat_empty"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
