<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ================= 配对面板（未配对时显示） ================= -->
    <LinearLayout
        android:id="@+id/view_pair_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background">

        <!-- 渐变头栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_gradient"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_title"
                android:textColor="@color/text_on_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_subtitle"
                android:textColor="@color/text_on_primary"
                android:textSize="@dimen/text_13"
                android:layout_marginTop="@dimen/space_4" />
        </LinearLayout>

        <!-- 配对卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/space_16"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="@dimen/space_24">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pair_input_card_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_15"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/space_16" />

                <EditText
                    android:id="@+id/et_pair_code"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/pair_code_hint"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textSize="@dimen/text_16"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/space_12" />

                <Button
                    android:id="@+id/btn_join_pair"
                    style="@style/Widget.EyeMonitor.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_confirm_pair"
                    android:layout_marginBottom="@dimen/space_12" />

                <Button
                    android:id="@+id/btn_create_pair"
                    style="@style/Widget.EyeMonitor.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_create_pair_code" />

                <TextView
                    android:id="@+id/tv_pair_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_14"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_12"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= 聊天面板（已配对时显示） ================= -->
    <FrameLayout
        android:id="@+id/view_chat_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:visibility="gone">

        <!-- 内容列（头栏/消息/底栏不因爱心占位而位移） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- 渐变头栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_header_gradient"
            android:padding="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_chat_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_title_default"
                    android:textColor="@color/text_on_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- 对方正在输入…（typing 事件时显示 3s） -->
                <TextView
                    android:id="@+id/tv_typing_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_typing_hint"
                    android:textColor="@color/text_on_primary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginTop="1dp" />

                <!-- 对方设备状态一行：电量图标+百分比 · 充电图标 · 网络 · 蓝牙图标 · 在线；点击进详情页 -->
                <LinearLayout
                    android:id="@+id/peer_status_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:id="@+id/iv_peer_battery"
                        android:layout_width="12dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_battery_lv2"
                        android:contentDescription="电量" />

                    <TextView
                        android:id="@+id/tv_peer_battery_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_on_primary_muted"
                        android:textSize="10sp"
                        android:layout_marginStart="2dp" />

                    <ImageView
                        android:id="@+id/iv_peer_charging"
                        android:layout_width="10dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_charging_off"
                        android:contentDescription="充电状态"
                        android:layout_marginStart="6dp" />

                    <TextView
                        android:id="@+id/tv_peer_network"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_on_primary_muted"
                        android:textSize="10sp"
                        android:layout_marginStart="4dp" />

                    <ImageView
                        android:id="@+id/iv_peer_bluetooth"
                        android:layout_width="10dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_bluetooth_off"
                        android:contentDescription="蓝牙"
                        android:layout_marginStart="6dp" />

                    <TextView
                        android:id="@+id/tv_peer_online"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_on_primary_muted"
                        android:textSize="10sp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 共享地图（图标 + 文字） -->
            <LinearLayout
                android:id="@+id/btn_chat_map"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_btn_white_rect"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_map"
                    android:tint="@color/text_on_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_share_map"
                    android:textColor="@color/text_on_primary"
                    android:textSize="13sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- 共享图库（图标 + 文字） -->
            <LinearLayout
                android:id="@+id/btn_chat_gallery"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_btn_white_rect"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_gallery"
                    android:tint="@color/text_on_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gallery_title"
                    android:textColor="@color/text_on_primary"
                    android:textSize="13sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>


        <!-- 消息列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="56dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

        <!-- 底部容器：输入栏 + 更多面板（一起滑入滑出） -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- 引用回复条（选择引用后出现，消息发送后消失） -->
        <LinearLayout
            android:id="@+id/ll_quote_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_quote_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/btn_quote_cancel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/cancel" />
        </LinearLayout>



        <!-- 录音浮动条（按压录音时显示：松开发送 · 滑到取消放弃） -->
        <LinearLayout
            android:id="@+id/ll_record_panel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/surface"
            android:elevation="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_record_hint"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/voice_release_to_send"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_record_cancel"
                android:layout_width="90dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:text="@string/voice_cancel"
                android:textColor="@color/status_error"
                android:textSize="15sp"
                android:background="@drawable/bg_record_cancel" />
        </LinearLayout>

        <!-- 底部输入栏：语音切换 + 输入框/按住说话 + 表情 + 媒体 + 发送 + 更多（微信式） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:elevation="4dp"
            android:padding="6dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_mic"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/voice_toggle"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/et_chat_input"
                style="@style/Widget.EyeMonitor.EditText"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:hint="@string/chat_hint_input"
                android:textSize="15sp"
                android:maxLines="4"
                android:inputType="textMultiLine" />

            <!-- 按住说话（语音模式时替代输入框） -->
            <TextView
                android:id="@+id/tv_voice_bar"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_voice_bar"
                android:text="@string/voice_hold_hint"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_emoji"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_emoji"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/chat_tool_emoji"
                android:layout_marginStart="4dp" />

            <!-- 发送（无输入灰色 / 有输入粉色） -->
            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_send"
                android:background="@drawable/bg_icon_circle"
                android:padding="11dp"
                android:contentDescription="@string/btn_send"
                android:layout_marginStart="4dp" />

            <!-- 更多（底部弹出菜单） -->
            <ImageButton
                android:id="@+id/btn_chat_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_more"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/menu_more"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- 更多面板（QQ 风格网格，弹出时占底部、顶起输入栏） -->
        <include
            android:id="@+id/more_panel"
            layout="@layout/view_more_panel"
            android:visibility="gone" />
        </LinearLayout>
        </LinearLayout>

        <!-- 纪念日：爱心悬浮叠层，居头栏与内容区接缝正中（图标固定，左右滑动切换数字/名称） -->
        <LinearLayout
            android:id="@+id/view_anniversary_heart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="54dp"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:id="@+id/iv_anniversary_heart"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_heart"
                    android:contentDescription="纪念日" />

                <TextView
                    android:id="@+id/tv_anniversary_heart_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:gravity="center" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_anniversary_heart_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:maxWidth="200dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
