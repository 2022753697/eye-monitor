<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 头栏：返回 + 标题 + 保存（统一 HeaderBar 视觉） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/bar_height_hero"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header_gradient_std"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btn_memo_edit_back"
            android:layout_width="@dimen/icon_44"
            android:layout_height="@dimen/icon_44"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="@color/white"
            android:background="@drawable/bg_header_icon"
            android:contentDescription="@string/cd_back"
            style="?attr/borderlessButtonStyle" />

        <TextView
            android:id="@+id/tv_memo_edit_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TextAppearance.EyeMonitor.HeaderTitle"
            android:textColor="@color/white"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_memo_save"
            style="@style/Widget.EyeMonitor.Button.HeaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/memo_save" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 正文输入 -->
            <EditText
                android:id="@+id/et_memo_content"
                style="@style/Widget.EyeMonitor.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="4"
                android:gravity="top"
                android:hint="@string/memo_hint"
                android:inputType="textMultiLine" />

            <!-- 图片条（已选图 + 加图） -->
            <LinearLayout
                android:id="@+id/ll_memo_edit_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp" />

            <!-- 子项编辑区 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/memo_item_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/ll_memo_edit_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/btn_memo_item_add"
                style="@style/Widget.EyeMonitor.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:text="@string/memo_item_add" />

            <!-- 提醒开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_memo_item"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/memo_reminder"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/sw_memo_reminder"
                    style="@style/Widget.EyeMonitor.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 提醒时间（开关打开时显示） -->
            <LinearLayout
                android:id="@+id/ll_memo_reminder_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_memo_item"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_alarm"
                    android:tint="@color/status_warn"
                    android:contentDescription="@string/cd_reminder" />

                <TextView
                    android:id="@+id/tv_memo_reminder_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 置顶开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_memo_item"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/memo_pin"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/sw_memo_pin"
                    style="@style/Widget.EyeMonitor.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>