<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 渐变头栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_gradient"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_on_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitle"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_13"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ============ 登录面板 ============ -->
            <LinearLayout
                android:id="@+id/panel_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="@dimen/space_24">

                <TextView
                    android:id="@+id/tv_login_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_20"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/space_16" />

                <EditText
                    android:id="@+id/et_username"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/login_username_hint"
                    android:inputType="text"
                    android:maxLength="64"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_password"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/login_password_hint"
                    android:inputType="textPassword"
                    android:maxLength="64"
                    android:layout_marginBottom="@dimen/space_16" />

                <Button
                    android:id="@+id/btn_login"
                    style="@style/Widget.EyeMonitor.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/login_button" />

                <TextView
                    android:id="@+id/tv_go_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_go_register"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_14"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_14"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ============ 注册面板（默认隐藏） ============ -->
            <LinearLayout
                android:id="@+id/panel_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="@dimen/space_24"
                android:layout_marginTop="@dimen/space_16"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reg_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_20"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/space_16" />

                <EditText
                    android:id="@+id/et_reg_username"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/login_username_hint"
                    android:inputType="text"
                    android:maxLength="64"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_reg_password"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/login_password_hint"
                    android:inputType="textPassword"
                    android:maxLength="64"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_reg_nickname"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/reg_nickname_hint"
                    android:inputType="text"
                    android:maxLength="32"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_reg_birthday"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/reg_birthday_hint"
                    android:inputType="datetime"
                    android:maxLength="10"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_reg_bio"
                    style="@style/Widget.EyeMonitor.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/reg_bio_hint"
                    android:inputType="text"
                    android:maxLength="60"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reg_gender_label"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_reg_female"
                        style="@style/Widget.EyeMonitor.RadioButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="@string/gender_option_female"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/rb_reg_male"
                        style="@style/Widget.EyeMonitor.RadioButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/gender_option_male"
                        android:textColor="@color/text_primary" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_register"
                    style="@style/Widget.EyeMonitor.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/reg_button"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tv_go_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reg_go_login"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_14"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_14"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- 服务器地址入口（登录/注册前可改，解决先有鸡还是先有蛋的死锁） -->
            <LinearLayout
                android:id="@+id/row_server_url_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/space_16"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/profile_server_url_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_14" />

                <TextView
                    android:id="@+id/tv_server_url_login_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_13"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 请求日志（调试面板）：实时显示发送的 API 请求/结果 -->
            <TextView
                android:id="@+id/tv_request_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="140dp"
                android:padding="8dp"
                android:background="@drawable/bg_card"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:typeface="monospace"
                android:lineSpacingExtra="2dp"
                android:maxLines="10"
                android:ellipsize="none"
                android:layout_marginTop="@dimen/space_8" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>