<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_task_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="@dimen/space_14"
    android:layout_marginStart="@dimen/space_16"
    android:layout_marginEnd="@dimen/space_16"
    android:layout_marginTop="@dimen/space_8"
    android:clickable="true"
    android:focusable="true">

    <!-- 行1：日期（左灰小字） + 状态 pill（右） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_task_card_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_11" />

        <TextView
            android:id="@+id/tv_task_card_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_gray"
            android:paddingStart="@dimen/space_10"
            android:paddingEnd="@dimen/space_10"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_11" />
    </LinearLayout>

    <!-- 行2：内容大字 -->
    <TextView
        android:id="@+id/tv_task_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 配图条（多图全部显示，横滑；点击放大） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_card_photos"
            android:layout_width="wrap_content"
            android:layout_height="120dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 行3：奖励 -->
    <TextView
        android:id="@+id/tv_task_card_reward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:textColor="@color/accent_text"
        android:textSize="@dimen/text_13" />
</LinearLayout>
