<?xml version="1.0" encoding="utf-8"?>
<!-- 对方文本气泡：左对齐；结构=昵称(顶) → 气泡 → 时间(下方左对齐) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:paddingStart="12dp"
    android:paddingEnd="60dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tv_chat_from"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="4dp" />

    <!-- 引用回复条（refMsgId>0 时显示，点击定位到原消息） -->
    <TextView
        android:id="@+id/tv_chat_ref"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="220dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/bg_quote_ref"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_chat_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_peer"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:lineSpacingExtra="2dp"
        android:padding="12dp" />

    <TextView
        android:id="@+id/tv_chat_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="4dp" />
</LinearLayout>