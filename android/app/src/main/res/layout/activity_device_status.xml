<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 渐变头栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header_gradient"
        android:padding="@dimen/space_16"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_title"
            style="@style/TextAppearance.EyeMonitor.HeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/device_status_title" />

        <Button
            android:id="@+id/btn_back"
            style="@style/Widget.EyeMonitor.Button.Header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back" />
    </LinearLayout>

    <!-- 五件套状态卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_alt"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:layout_margin="@dimen/space_12">

        <!-- 在线状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/space_14"
            android:paddingBottom="@dimen/space_14">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_online"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />

            <TextView
                android:id="@+id/tv_device_online"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_offline"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_15"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 电量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/space_14"
            android:paddingBottom="@dimen/space_14">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_battery"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />

            <TextView
                android:id="@+id/tv_device_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_unknown"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 充电 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/space_14"
            android:paddingBottom="@dimen/space_14">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_charging"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />

            <TextView
                android:id="@+id/tv_device_charging"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_not_charging"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 网络 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/space_14"
            android:paddingBottom="@dimen/space_14">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_network"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />

            <TextView
                android:id="@+id/tv_device_network"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_unknown"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 蓝牙 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/space_14"
            android:paddingBottom="@dimen/space_14">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_bluetooth"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />

            <TextView
                android:id="@+id/tv_device_bluetooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_off"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.EyeMonitor.Label"
        android:text="@string/device_status_tip"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16" />
</LinearLayout>
