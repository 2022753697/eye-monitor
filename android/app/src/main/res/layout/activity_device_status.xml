<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 统一头栏（v2 §2.10：std 渐变 + icon 返回 + 标题「对方设备状态」20sp 居中） -->
    <include
        layout="@layout/component_header_bar"
        android:id="@+id/header_device_status_bar" />

    <!-- 五件套状态卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_alt"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:layout_margin="@dimen/space_12">

        <!-- 在线状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/space_14"
            android:paddingBottom="@dimen/space_14">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_online"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />

            <TextView
                android:id="@+id/tv_device_online"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_offline"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_15"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 电量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/space_14"
            android:paddingBottom="@dimen/space_14">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_battery"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />

            <TextView
                android:id="@+id/tv_device_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_unknown"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 充电 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/space_14"
            android:paddingBottom="@dimen/space_14">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_charging"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />

            <TextView
                android:id="@+id/tv_device_charging"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_not_charging"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 网络 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/space_14"
            android:paddingBottom="@dimen/space_14">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_network"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />

            <TextView
                android:id="@+id/tv_device_network"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_unknown"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 蓝牙 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/space_14"
            android:paddingBottom="@dimen/space_14">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_bluetooth"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />

            <TextView
                android:id="@+id/tv_device_bluetooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_off"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 电池优化白名单（本机） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/space_14"
            android:paddingBottom="@dimen/space_14"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/battery_opt_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />

            <TextView
                android:id="@+id/tv_battery_opt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_opt_not_exempt"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_15" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 备注（微信式：备注优先显示名） -->
        <LinearLayout
            android:id="@+id/row_peer_remark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/space_14"
            android:paddingBottom="@dimen/space_14"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/peer_remark_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_15" />

            <TextView
                android:id="@+id/tv_peer_remark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peer_remark_not_set"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_15" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.EyeMonitor.Label"
        android:text="@string/device_status_tip"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16" />
</LinearLayout>
