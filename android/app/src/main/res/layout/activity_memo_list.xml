<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 头栏：标题 + 新建按钮（统一 HeaderBar 视觉） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/bar_height_hero"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header_gradient_std"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btn_memo_back"
            android:layout_width="@dimen/icon_44"
            android:layout_height="@dimen/icon_44"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="@color/white"
            android:background="@drawable/bg_header_icon"
            android:contentDescription="返回"
            style="?attr/borderlessButtonStyle" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/memo_title"
            style="@style/TextAppearance.EyeMonitor.HeaderTitle"
            android:textColor="@color/white"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_memo_new"
            style="@style/Widget.EyeMonitor.Button.HeaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/memo_new" />
    </LinearLayout>

    <!-- 备忘录列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_memos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp"
        android:paddingBottom="24dp" />

    <!-- 空态（组件化） -->
    <include
        layout="@layout/component_empty_state"
        android:id="@+id/es_memo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>