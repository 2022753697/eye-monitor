<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_media_bubble"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tv_chat_from"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="4dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/fl_media_container"
        android:layout_width="180dp"
        android:layout_height="180dp">

        <ImageView
            android:id="@+id/iv_media_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/ll_media_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_media_placeholder">

            <ImageView
                android:id="@+id/iv_media_placeholder_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_image"
                android:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_media_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/media_download_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fl_video_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:padding="6dp"
            android:visibility="gone">

            <View
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_play_badge" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_play"
                android:padding="8dp"
                android:contentDescription="@string/video" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tv_chat_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:layout_marginTop="2dp" />
</LinearLayout>