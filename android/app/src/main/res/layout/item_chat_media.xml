<?xml version="1.0" encoding="utf-8"?>
<!-- 媒体/语音气泡（根=FrameLayout 悬浮层，同文本气泡装饰架构）：内容块 + 耳/爪悬浮 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_bubble_decor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/ll_media_bubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_chat_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/text_12"
            android:layout_marginBottom="@dimen/space_2"
            android:layout_marginStart="@dimen/space_4"
            android:visibility="gone" />

        <!-- 装饰容器：媒体气泡本体 + 耳/爪悬浮（锚定气泡本身） -->
        <FrameLayout
            android:id="@+id/ll_bubble_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:id="@+id/fl_media_container"
                android:layout_width="180dp"
                android:layout_height="180dp">
                <!-- v2 §2.2：媒体气泡本体 180dp 远大于 44dp 触控目标，长按/触摸菜单热区达标（Java 长按回调不动） -->

                <ImageView
                    android:id="@+id/iv_media_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="3dp"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:id="@+id/ll_media_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="3dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_media_placeholder">

                    <ImageView
                        android:id="@+id/iv_media_placeholder_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_image"
                        android:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_media_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/media_download_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_12"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 语音气泡（微信式）：旋转 wifi 图标 + 秒数，图片/视频时隐藏 -->
                <LinearLayout
                    android:id="@+id/ll_voice_bubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/iv_voice_wifi"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_wifi_voice"
                        android:tint="@color/primary" />

                    <com.eyemonitor.ui.WaveformView
                        android:id="@+id/waveform_view"
                        android:layout_width="96dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_voice_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/fl_video_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:padding="6dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_play_badge" />

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_play"
                        android:padding="8dp"
                        android:contentDescription="@string/video" />
                </FrameLayout>
            </FrameLayout>

            <!-- 主题装饰悬浮层（同文本气泡：耳 top 角 / 爪 bottom 角，bind 按主题显隐） -->
            <ImageView
                android:id="@+id/iv_bubble_ear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_bubble_paw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_chat_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_9"
            android:layout_marginTop="@dimen/space_2" />
    </LinearLayout>
</FrameLayout>
