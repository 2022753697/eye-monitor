<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_24"
    android:paddingTop="@dimen/space_8">

    <EditText
        android:id="@+id/et_anni_name"
        style="@style/Widget.EyeMonitor.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/anniversary_name_hint"
        android:maxLines="2"
        android:inputType="textCapSentences" />

    <EditText
        android:id="@+id/et_anni_date"
        style="@style/Widget.EyeMonitor.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/anniversary_date_hint"
        android:focusable="false"
        android:layout_marginTop="@dimen/space_12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/space_12">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/anniversary_repeat_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_15" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_anni_repeat"
            style="@style/Widget.EyeMonitor.Switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>